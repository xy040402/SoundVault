<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== 浅色 token ===== -->
      <!-- 鼠标光晕（浅色：墨色，白底上白光是看不见的） -->
    <RadialGradientBrush x:Key="PointerGlowBrush">
        <GradientStop Offset="0" Color="#7A38BDF8"/>
        <GradientStop Offset="0.5" Color="#3338BDF8"/>
        <GradientStop Offset="1" Color="#0038BDF8"/>
    </RadialGradientBrush>
<SolidColorBrush x:Key="WindowBg"        Color="#FFEAEDF3"/>
  <SolidColorBrush x:Key="PanelBg"         Color="#8CFFFFFF"/>
  <SolidColorBrush x:Key="PanelBorder"     Color="#1F000000"/>
  <SolidColorBrush x:Key="TextPrimary"     Color="#FF12161F"/>
  <SolidColorBrush x:Key="TextSecondary"   Color="#FF49515F"/>
  <SolidColorBrush x:Key="TextTertiary"    Color="#FF6E7686"/>
  <SolidColorBrush x:Key="Accent"          Color="#FF0369A1"/>
  <SolidColorBrush x:Key="AccentSoft"      Color="#220369A1"/>
  <SolidColorBrush x:Key="AccentBorder"    Color="#800369A1"/>
  <SolidColorBrush x:Key="OnAccent"        Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="CardBg"          Color="#D9FFFFFF"/>
  <SolidColorBrush x:Key="CardHover"       Color="#FFF3F6FB"/>
  <SolidColorBrush x:Key="CardBorder"      Color="#14000000"/>
  <SolidColorBrush x:Key="HoverBg"         Color="#66FFFFFF"/>
  <SolidColorBrush x:Key="Wave"            Color="#80465268"/>
  <SolidColorBrush x:Key="WavePlayed"      Color="#FF0369A1"/>
  <SolidColorBrush x:Key="Playhead"        Color="#FF0B1220"/>
  <SolidColorBrush x:Key="WavePlate"       Color="#0D141E32"/>
  <SolidColorBrush x:Key="SearchBg"        Color="#D9FFFFFF"/>
  <SolidColorBrush x:Key="ToolbarBg"       Color="#66FFFFFF"/>
  <SolidColorBrush x:Key="WindowEdge"      Color="#33000000"/>
  <SolidColorBrush x:Key="MenuBg"          Color="#FAFFFFFF"/>
    <SolidColorBrush x:Key="OverlayBg"       Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="OverlayBorder"   Color="#22000000"/>
  <SolidColorBrush x:Key="ScrollThumb"     Color="#33000000"/>
  <SolidColorBrush x:Key="Divider"         Color="#24000000"/>
  <SolidColorBrush x:Key="PillHoverBg"     Color="#14000000"/>
  <SolidColorBrush x:Key="AccentSoftHover" Color="#330369A1"/>

  <RadialGradientBrush x:Key="AmbientA" GradientOrigin="0.15,0.05" Center="0.15,0.05" RadiusX="0.75" RadiusY="0.85">
    <GradientStop Color="#55BFDBFE" Offset="0"/>
    <GradientStop Color="#00F2F5FA" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientB" GradientOrigin="0.95,0.9" Center="0.95,0.9" RadiusX="0.7" RadiusY="0.8">
    <GradientStop Color="#4CDDD6FE" Offset="0"/>
    <GradientStop Color="#00F2F5FA" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientC" GradientOrigin="0.75,0.05" Center="0.72,0.05" RadiusX="0.5" RadiusY="0.6">
    <GradientStop Color="#3ACFFAFE" Offset="0"/>
    <GradientStop Color="#00F2F5FA" Offset="1"/>
  </RadialGradientBrush>

  <Style x:Key="T1" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="T2" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="T3" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    <Setter Property="FontSize" Value="10.5"/>
  </Style>

  <Style x:Key="SideRow" TargetType="Border">
    <Setter Property="Height" Value="28"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="7,0"/>
  </Style>

  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Height" Value="28"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

</ResourceDictionary>
