<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== 深色 token ===== -->
      <!-- 鼠标光晕（深色：白色） -->
    <RadialGradientBrush x:Key="PointerGlowBrush">
        <GradientStop Offset="0" Color="#3DFFFFFF"/>
        <GradientStop Offset="0.55" Color="#12FFFFFF"/>
        <GradientStop Offset="1" Color="#00FFFFFF"/>
    </RadialGradientBrush>
<SolidColorBrush x:Key="WindowBg"        Color="#FF0A0C10"/>
  <SolidColorBrush x:Key="PanelBg"         Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="PanelBorder"     Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="TextPrimary"     Color="#FFE9ECF2"/>
  <SolidColorBrush x:Key="TextSecondary"   Color="#FF9AA3B2"/>
  <SolidColorBrush x:Key="TextTertiary"    Color="#FF69717F"/>
  <SolidColorBrush x:Key="Accent"          Color="#FF38BDF8"/>
  <SolidColorBrush x:Key="AccentSoft"      Color="#2438BDF8"/>
  <SolidColorBrush x:Key="AccentBorder"    Color="#8038BDF8"/>
  <SolidColorBrush x:Key="OnAccent"        Color="#FF04121C"/>
  <SolidColorBrush x:Key="CardBg"          Color="#0CFFFFFF"/>
  <SolidColorBrush x:Key="CardHover"       Color="#18FFFFFF"/>
  <SolidColorBrush x:Key="CardBorder"      Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="HoverBg"         Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="Wave"            Color="#8CA0ACC0"/>
  <SolidColorBrush x:Key="WavePlayed"      Color="#FF38BDF8"/>
  <SolidColorBrush x:Key="Playhead"        Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="WavePlate"       Color="#29000000"/>
  <SolidColorBrush x:Key="SearchBg"        Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="ToolbarBg"       Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="WindowEdge"      Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="MenuBg"          Color="#F5171B23"/>
    <SolidColorBrush x:Key="OverlayBg"       Color="#F51A1E27"/>
    <SolidColorBrush x:Key="OverlayBorder"   Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="ScrollThumb"     Color="#33FFFFFF"/>
  <SolidColorBrush x:Key="Divider"         Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="PillHoverBg"     Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="AccentSoftHover" Color="#3A38BDF8"/>

  <!-- 环境光：模拟桌面壁纸透出，让玻璃面板有东西可透 -->
  <RadialGradientBrush x:Key="AmbientA" GradientOrigin="0.15,0.05" Center="0.15,0.05" RadiusX="0.75" RadiusY="0.85">
    <GradientStop Color="#3A2563EB" Offset="0"/>
    <GradientStop Color="#00101820" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientB" GradientOrigin="0.95,0.9" Center="0.95,0.9" RadiusX="0.7" RadiusY="0.8">
    <GradientStop Color="#338B5CF6" Offset="0"/>
    <GradientStop Color="#00101820" Offset="1"/>
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="AmbientC" GradientOrigin="0.75,0.05" Center="0.72,0.05" RadiusX="0.5" RadiusY="0.6">
    <GradientStop Color="#2A0891B2" Offset="0"/>
    <GradientStop Color="#00101820" Offset="1"/>
  </RadialGradientBrush>

  <!-- 圆角 token：SurfaceTheme 会按"圆角"设置整体缩放这几个值 -->
  <CornerRadius x:Key="R6">6</CornerRadius>
  <CornerRadius x:Key="R7">7</CornerRadius>
  <CornerRadius x:Key="R8">8</CornerRadius>
  <CornerRadius x:Key="R9">9</CornerRadius>
  <CornerRadius x:Key="R10">10</CornerRadius>
  <CornerRadius x:Key="R12">12</CornerRadius>
  <!-- ===== 通用文本样式 ===== -->
  <Style x:Key="T1" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="T2" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="T3" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
    <Setter Property="FontSize" Value="10.5"/>
  </Style>

  <!-- ===== 左栏行 ===== -->
  <Style x:Key="SideRow" TargetType="Border">
    <Setter Property="Height" Value="28"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="7,0"/>
  </Style>

  <!-- ===== 胶囊 ===== -->
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Height" Value="28"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

</ResourceDictionary>
