<Window x:Class="SoundVault.App.Dialogs.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音匣 · 导出" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="520" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="14" Padding="22,18,22,16" Margin="18"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="文件命名" FontSize="10.5" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondary}"/>
            <Border Height="32" CornerRadius="8" Background="{DynamicResource SearchBg}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10,0">
                <TextBox x:Name="TemplateBox" Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{DynamicResource TextPrimary}" VerticalContentAlignment="Center"
                         CaretBrush="{DynamicResource Accent}"/>
            </Border>
            <TextBlock Text="可用：{n:00} 序号 · {name} 名称 · {index} 原编号 · {dur} 时长 · {sr} 采样率 · {ch} 声道 · {lib} 库名"
                       FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiary}"/>
            <TextBlock x:Name="PreviewText" FontSize="10.5" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondary}"/>

            <!-- 保留目录结构 -->
            <CheckBox x:Name="KeepBox" Content="保留原来的文件夹结构" Margin="0,16,0,0" FontSize="11"
                      Focusable="False" Foreground="{DynamicResource TextSecondary}">
                <CheckBox.Template>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0"
                                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1">
                                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </CheckBox.Template>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Border Height="30" CornerRadius="8" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"
                        Background="Transparent" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                        MouseLeftButtonDown="Cancel_Click">
                    <TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </Border>
                <Border Height="30" CornerRadius="8" Padding="18,0" Cursor="Hand"
                        Background="{DynamicResource Accent}" MouseLeftButtonDown="Ok_Click">
                    <TextBlock Text="开始导出" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
