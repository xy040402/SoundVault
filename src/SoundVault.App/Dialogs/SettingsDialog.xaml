<Window x:Class="SoundVault.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音匣 · 设置" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" Margin="0,0,9,0"
                                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1">
                                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        </Style>

        <Style x:Key="Btn" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="BtnText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="14" Padding="22,18,22,16" Margin="18"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>

            <!-- 主题 -->
            <TextBlock Text="主题" Style="{StaticResource Section}"/>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="DarkBtn" Style="{StaticResource Btn}" MouseLeftButtonDown="Dark_Click" Width="76"
                        HorizontalAlignment="Left">
                    <TextBlock Text="深色" Style="{StaticResource BtnText}" HorizontalAlignment="Center"/>
                </Border>
                <Border x:Name="LightBtn" Style="{StaticResource Btn}" MouseLeftButtonDown="Light_Click" Width="76"
                        HorizontalAlignment="Left">
                    <TextBlock Text="浅色" Style="{StaticResource BtnText}" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- 外观 -->
            <TextBlock Text="外观" Style="{StaticResource Section}"/>
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Btn}" MouseLeftButtonDown="Appearance_Click">
                    <TextBlock Text="主色 / 面板强度 / 圆角 / 云母…" Style="{StaticResource BtnText}"/>
                </Border>
            </StackPanel>

            <!-- 窗口 -->
            <TextBlock Text="窗口" Style="{StaticResource Section}"/>
            <CheckBox x:Name="TopmostBox" Content="窗口置顶（盖在别的软件上面，方便往 DAW 里拖）" Style="{StaticResource Check}"/>
            <CheckBox x:Name="PowerSaverBox" Content="省电模式（界面刷新限制 60fps）" Style="{StaticResource Check}"/>

            <!-- 导出 -->
            <TextBlock Text="导出" Style="{StaticResource Section}"/>
            <Border Height="32" CornerRadius="8" Background="{DynamicResource SearchBg}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10,0">
                <TextBox x:Name="TemplateBox" Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{DynamicResource TextPrimary}" VerticalContentAlignment="Center"
                         CaretBrush="{DynamicResource Accent}"/>
            </Border>
            <TextBlock Text="默认命名模板：{n:00} 序号 · {name} 名称 · {index} 原编号 · {dur} 时长 · {sr} 采样率 · {ch} 声道 · {lib} 库名"
                       FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiary}"/>

            <!-- 文件名清洗 -->
            <TextBlock Text="文件名清洗" Style="{StaticResource Section}"/>
            <Border MinHeight="52" CornerRadius="8" Background="{DynamicResource SearchBg}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="8,6">
                <TextBox x:Name="RulesBox" Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{DynamicResource TextPrimary}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" CaretBrush="{DynamicResource Accent}" Height="44"/>
            </Border>
            <TextBlock Text="一行一条。文件名最后一个「-」之后如果含这些词，就把那一段去掉（拔刀相向-叮咚社版权素材 → 拔刀相向）"
                       FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiary}"/>

            <!-- 文件关联 -->
            <TextBlock Text="文件关联" Style="{StaticResource Section}"/>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="AssocBtn" Style="{StaticResource Btn}" MouseLeftButtonDown="Assoc_Click">
                    <TextBlock x:Name="AssocText" Text="注册右键「添加到音匣」" Style="{StaticResource BtnText}"/>
                </Border>
            </StackPanel>
            <TextBlock Text="只写当前用户的注册表（HKCU），不需要管理员权限。支持 .wav .mp3 .flac .aif .aiff .ogg .m4a"
                       FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiary}"/>

            <!-- 数据 -->
            <TextBlock Text="数据" Style="{StaticResource Section}"/>
            <TextBlock x:Name="PathText" FontSize="10.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Border Style="{StaticResource Btn}" MouseLeftButtonDown="OpenData_Click">
                    <TextBlock Text="打开数据目录" Style="{StaticResource BtnText}"/>
                </Border>
                <Border Style="{StaticResource Btn}" MouseLeftButtonDown="Rebuild_Click">
                    <TextBlock Text="重建索引…" Style="{StaticResource BtnText}"/>
                </Border>
                <Border x:Name="PortableBtn" Style="{StaticResource Btn}" MouseLeftButtonDown="Portable_Click">
                    <TextBlock Text="切换为便携模式" Style="{StaticResource BtnText}"/>
                </Border>
        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="Backup_Click">
            <TextBlock Text="备份数据…" Style="{StaticResource BtnText}"/>
        </Border>
            </StackPanel>

            <TextBlock x:Name="PortableText" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiary}"/>

            <TextBlock x:Name="VersionText" FontSize="10" Margin="0,14,0,0"
                       Foreground="{DynamicResource TextTertiary}"/>

            <Border Height="28" CornerRadius="8" Padding="12,0" Margin="0,8,0,0" Cursor="Hand"
                    HorizontalAlignment="Left" Background="Transparent" BorderThickness="1"
                    BorderBrush="{DynamicResource PanelBorder}" MouseLeftButtonDown="ReplayOnboarding_Click">
                <TextBlock Text="看一遍新手引导 ›" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Border>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Border Height="30" CornerRadius="8" Padding="16,0" Margin="0,0,8,0" Cursor="Hand"
                        Background="Transparent" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                        MouseLeftButtonDown="Cancel_Click">
                    <TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </Border>
                <Border Height="30" CornerRadius="8" Padding="18,0" Cursor="Hand"
                        Background="{DynamicResource Accent}" MouseLeftButtonDown="Ok_Click">
                    <TextBlock Text="保存" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
