<Window x:Class="SoundVault.App.Dialogs.ThemeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音匣 · 外观" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <!-- 细滑杆：轨道 + 圆点，跟应用其它控件一个调子 -->
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <!-- 点轨道就跳到那个位置，不用非得拖圆点 -->
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <!-- Background=Transparent：整行都能点/拖，不然只有那条 4px 细线可点 -->
                        <Grid VerticalAlignment="Center" Background="Transparent" Height="20">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource PanelBg}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" CornerRadius="7"
                                                        Background="{DynamicResource Accent}"
                                                        BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.6"
                                                                          Color="#000000"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="14" Padding="22,18,22,16" Margin="18"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="外观" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock Text="选一个主色，或者自己调。所有强调色、播放头、标签都会跟着变。"
                       FontSize="11" Margin="0,5,0,0" Foreground="{DynamicResource TextTertiary}"/>

            <!-- 预设 -->
            <TextBlock Text="预设" FontSize="10.5" Margin="0,16,0,7" Foreground="{DynamicResource TextSecondary}"/>
            <StackPanel x:Name="PresetRow" Orientation="Horizontal"/>

            <!-- HEX -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEX" FontSize="11" VerticalAlignment="Center" Width="34"
                           Foreground="{DynamicResource TextSecondary}"/>
                <Border Grid.Column="1" Width="96" Height="30" CornerRadius="8" Background="{DynamicResource SearchBg}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10,0">
                    <TextBox x:Name="HexBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimary}" VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource Accent}" TextChanged="HexBox_TextChanged"/>
                </Border>
                <Border Grid.Column="2" x:Name="Swatch" Width="30" Height="30" CornerRadius="8" Margin="10,0,0,0"
                        HorizontalAlignment="Left" BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1"/>
            </Grid>

            <!-- RGB -->
            <TextBlock Text="RGB" FontSize="10.5" Margin="0,16,0,6" Foreground="{DynamicResource TextSecondary}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>
                <TextBlock Text="R" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <Slider x:Name="RSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="255"
                        IsSnapToTickEnabled="True" ValueChanged="Rgb_Changed"/>
                <TextBlock x:Name="RText" Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="1" Text="G" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <Slider x:Name="GSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="255"
                        IsSnapToTickEnabled="True" ValueChanged="Rgb_Changed"/>
                <TextBlock x:Name="GText" Grid.Row="1" Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="2" Text="B" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <Slider x:Name="BSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="255"
                        IsSnapToTickEnabled="True" ValueChanged="Rgb_Changed"/>
                <TextBlock x:Name="BText" Grid.Row="2" Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Grid>

            <!-- HSV -->
            <TextBlock Text="HSV" FontSize="10.5" Margin="0,10,0,6" Foreground="{DynamicResource TextSecondary}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="24"/>
                </Grid.RowDefinitions>
                <TextBlock Text="H" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <Slider x:Name="HSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="360"
                        ValueChanged="Hsv_Changed"/>
                <TextBlock x:Name="HText" Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="1" Text="S" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <Slider x:Name="SSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                        ValueChanged="Hsv_Changed"/>
                <TextBlock x:Name="SText" Grid.Row="1" Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Grid.Row="2" Text="V" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                <Slider x:Name="VSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                        ValueChanged="Hsv_Changed"/>
                <TextBlock x:Name="VText" Grid.Row="2" Grid.Column="2" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextPrimary}"/>
            </Grid>

            <!-- 面板强度 -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="面板强度" FontSize="10.5" VerticalAlignment="Center" Width="56"
                           Foreground="{DynamicResource TextSecondary}"/>
                <Slider x:Name="GlassSlider" Grid.Column="1" Style="{StaticResource ThinSlider}"
                        Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2"
                        ValueChanged="Glass_Changed"/>
                <TextBlock x:Name="GlassText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/>
            </Grid>
            <TextBlock Text="往左更透（能看见背景光），往右更实（字更清楚）" FontSize="10" Margin="56,3,0,0"
                       Foreground="{DynamicResource TextTertiary}"/>

            <!-- 圆角 -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="44"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="圆角" FontSize="10.5" VerticalAlignment="Center" Width="56"
                           Foreground="{DynamicResource TextSecondary}"/>
                <Slider x:Name="RadiusSlider" Grid.Column="1" Style="{StaticResource ThinSlider}"
                        Minimum="0" Maximum="1.6" SmallChange="0.05" LargeChange="0.2"
                        ValueChanged="Radius_Changed"/>
                <TextBlock x:Name="RadiusText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/>
            </Grid>

            <!-- 云母 -->
            <CheckBox x:Name="MicaBox" Content="Windows 11 云母底板（窗口透出桌面模糊；Win10 上无效）"
                      Margin="0,12,0,0" FontSize="11" Focusable="False"
                      Foreground="{DynamicResource TextSecondary}">
                <CheckBox.Template>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="mbox" Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0"
                                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1">
                                <TextBlock x:Name="mtick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mbox" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="mbox" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="mtick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </CheckBox.Template>
            </CheckBox>

            <!-- 省电档 -->
            <CheckBox x:Name="PowerSaverBox" Content="省电模式（界面刷新限制 60fps，笔记本更省电）"
                      Margin="0,16,0,0" FontSize="11" Focusable="False"
                      Foreground="{DynamicResource TextSecondary}">
                <CheckBox.Template>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0"
                                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1">
                                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </CheckBox.Template>
            </CheckBox>

            <!-- 预览 -->
            <TextBlock Text="预览" FontSize="10.5" Margin="0,16,0,7" Foreground="{DynamicResource TextSecondary}"/>
            <Border CornerRadius="10" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1" Padding="12" Height="64">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PrevButton" Width="90" Height="30" CornerRadius="8">
                        <TextBlock Text="播放一下" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="PrevTag" Height="22" CornerRadius="6" Padding="8,0" Margin="12,0,0,0" BorderThickness="1">
                        <TextBlock Text="#武侠" FontSize="10" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PrevStars" Text="★★★★☆" FontSize="13" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Border Style="{StaticResource Chip}" Background="Transparent" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource PanelBorder}" MouseLeftButtonDown="Import_Click">
                    <TextBlock Text="导入主题…" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource Chip}" Background="Transparent" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource PanelBorder}" MouseLeftButtonDown="Export_Click">
                    <TextBlock Text="导出主题…" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource Chip}" Background="Transparent" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource PanelBorder}" MouseLeftButtonDown="Cancel_Click">
                    <TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </Border>
                <Border Style="{StaticResource Chip}" Background="{DynamicResource PanelBg}" Margin="0,0,8,0"
                        BorderBrush="{DynamicResource PanelBorder}" MouseLeftButtonDown="Reset_Click">
                    <TextBlock Text="恢复默认" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="OkBtn" Style="{StaticResource Chip}" Background="{DynamicResource Accent}"
                        BorderThickness="0" MouseLeftButtonDown="Ok_Click">
                    <TextBlock Text="应用" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
