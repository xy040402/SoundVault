<Window x:Class="SoundVault.App.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音匣" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="False"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Border x:Name="Root" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="14" Padding="22,18,22,16" Margin="18"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>
            <TextBlock x:Name="BodyText" Margin="0,6,0,0" LineHeight="19" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed"/>

            <Border Margin="0,14,0,0" Height="34" CornerRadius="9" Background="{DynamicResource SearchBg}"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10,0">
                <TextBox x:Name="ValueBox" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource Accent}"
                         VerticalContentAlignment="Center" FontSize="12.5"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Click="Cancel_Click" Focusable="False" Cursor="Hand" Margin="0,0,8,0"
                        AutomationProperties.Name="取消">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Height="30" CornerRadius="8" Padding="16,0" Background="Transparent"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                                <TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Click="Ok_Click" Focusable="False" Cursor="Hand" AutomationProperties.Name="确定">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Height="30" CornerRadius="8" Padding="18,0" Background="{DynamicResource Accent}">
                                <TextBlock Text="好" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
