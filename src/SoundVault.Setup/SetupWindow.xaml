<Window x:Class="SoundVault.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 音匣 SoundVault" Width="560" Height="430" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FF141821" FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseDown">

    <Border BorderBrush="#FF2A3040" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Background="#FF1B2130">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Width="30" Height="30" Stretch="Uniform" Source="/Assets/logo-256.png"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="音匣 SoundVault" FontSize="14" FontWeight="SemiBold" Foreground="#FFF2F5FA"/>
                        <TextBlock x:Name="SubText" Text="本地音效库管理器" FontSize="10.5" Foreground="#FF8A93A6"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="46" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Foreground="#FF8A93A6" FontSize="12"
                        Click="Close_Click"/>
            </Grid>

            <!-- 主体 -->
            <StackPanel Grid.Row="1" Margin="22,18,22,0">
                <TextBlock Text="安装位置" FontSize="10.5" Foreground="#FF8A93A6"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#FF1B2130" BorderBrush="#FF2A3040" BorderThickness="1" CornerRadius="8" Height="34">
                        <TextBox x:Name="PathBox" Background="Transparent" BorderThickness="0" Foreground="#FFF2F5FA"
                                 VerticalContentAlignment="Center" Margin="10,0" CaretBrush="#FF38BDF8" LostFocus="PathBox_LostFocus"/>
                    </Border>
                    <Button Grid.Column="1" Content="浏览…" Width="72" Height="34" Margin="8,0,0,0"
                            Background="#FF1B2130" Foreground="#FFC8D0DE" BorderBrush="#FF2A3040" BorderThickness="1"
                            Click="Browse_Click"/>
                </Grid>

                <CheckBox x:Name="StartMenuBox" Content="创建开始菜单快捷方式" IsChecked="True" Margin="0,16,0,0"
                          Foreground="#FFC8D0DE"/>
                <CheckBox x:Name="DesktopBox" Content="创建桌面快捷方式" IsChecked="True" Margin="0,8,0,0"
                          Foreground="#FFC8D0DE"/>

                <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="#FF1B2130" Margin="0,20,0,0">
                    <Grid>
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                                Background="#FF38BDF8"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="LogText" Foreground="#FF8A93A6" FontSize="10.5" Margin="0,8,0,0"
                           TextWrapping="Wrap" Height="42"/>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,22,0"
                        VerticalAlignment="Center">
                <Button x:Name="CancelBtn" Content="取消" Width="88" Height="32" Margin="0,0,8,0"
                        Background="Transparent" Foreground="#FFC8D0DE" BorderBrush="#FF2A3040" BorderThickness="1"
                        Click="Close_Click"/>
                <Button x:Name="InstallBtn" Content="安装" Width="110" Height="32"
                        Background="#FF38BDF8" Foreground="#FF0B1220" BorderThickness="0" FontWeight="SemiBold"
                        Click="Install_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
