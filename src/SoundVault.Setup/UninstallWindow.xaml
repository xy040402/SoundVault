<Window x:Class="SoundVault.Setup.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="卸载 音匣 SoundVault" Width="560" Height="470" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FF141821" FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseDown">

    <Border BorderBrush="#FF2A3040" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Background="#FF1B2130">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Image Width="30" Height="30" Stretch="Uniform" Source="/Assets/logo-256.png"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="音匣 SoundVault" FontSize="14" FontWeight="SemiBold" Foreground="#FFF2F5FA"/>
                        <TextBlock Text="卸载程序" FontSize="10.5" Foreground="#FF8A93A6"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" Width="46" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Foreground="#FF8A93A6" FontSize="12"
                        Click="Close_Click"/>
            </Grid>

            <!-- 主体 -->
            <StackPanel Grid.Row="1" Margin="22,18,22,0">
                <TextBlock x:Name="Headline" Text="即将卸载 音匣 SoundVault"
                           FontSize="15" FontWeight="SemiBold" Foreground="#FFF2F5FA"/>

                <TextBlock x:Name="IntroText" Margin="0,8,0,0" FontSize="11" Foreground="#FFC8D0DE"
                           TextWrapping="Wrap" LineHeight="19"
                           Text="将从下面的位置移除程序文件、开始菜单与桌面快捷方式、以及「应用和功能」里的登记项。"/>

                <Border Background="#FF1B2130" BorderBrush="#FF2A3040" BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="安装位置" FontSize="10" Foreground="#FF8A93A6"/>
                        <TextBlock x:Name="DirText" FontSize="11" Margin="0,3,0,0" Foreground="#FFF2F5FA"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="软件数据" FontSize="10" Margin="0,10,0,0" Foreground="#FF8A93A6"/>
                        <TextBlock x:Name="DataText" FontSize="11" Margin="0,3,0,0" Foreground="#FFC8D0DE"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 数据选项 -->
                <CheckBox x:Name="DeleteDataBox" Margin="0,14,0,0" Foreground="#FFF2F5FA"
                          Content="同时删除软件数据（评分、标签、集合、播放历史）"/>
                <TextBlock x:Name="DataHint" Margin="24,6,0,0" FontSize="10.5" Foreground="#FF8A93A6"
                           TextWrapping="Wrap"
                           Text="不勾选：数据保留，以后重装会接着用；勾选：删了就找不回来（你的音效文件不受影响）。"/>

                <!-- 进度 -->
                <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="#FF1B2130" Margin="0,20,0,0">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                            Background="#FF38BDF8"/>
                </Border>
                <TextBlock x:Name="LogText" Foreground="#FF8A93A6" FontSize="10.5" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,20,0">
                <Button x:Name="CancelBtn" Content="取消" Width="88" Height="32" Margin="0,0,8,0"
                        Background="#FF1B2130" Foreground="#FFC8D0DE" BorderBrush="#FF2A3040" BorderThickness="1"
                        Click="Close_Click"/>
                <Button x:Name="ActionBtn" Content="卸载" Width="110" Height="32"
                        Background="#FF38BDF8" Foreground="#FF0B1017" BorderThickness="0" FontWeight="SemiBold"
                        Click="Action_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
