<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>音匣 SoundVault 安装程序</Product>
    <AssemblyName>音匣安装包</AssemblyName>
    <RootNamespace>SoundVault.Setup</RootNamespace>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 主程序内嵌进来：安装包本身就是完整的一个 exe -->
    <EmbeddedResource Include="..\..\_local\dist\音匣.exe"
                      LogicalName="SoundVault.App.exe"
                      Condition="Exists('..\..\_local\dist\音匣.exe')" />
  </ItemGroup>

</Project>
