<Window x:Class="SoundVault.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音匣 · 设置" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="760" Height="640" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,9,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" Margin="0,0,9,0"
                                    Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1">
                                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分组卡片 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
        </Style>

        <Style x:Key="Btn" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="BtnText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <!-- 主题卡片（深/浅） -->
        <Style x:Key="ThemeCard" TargetType="Border">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="86"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- 左侧导航项 -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent">
                            <Grid>
                                <Border x:Name="bar" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="Transparent"/>
                                <ContentPresenter Margin="16,0,8,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 细滑杆（从外观窗口搬过来的，保持手感一致） -->
        <Style x:Key="ThinSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent" Height="20">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource PanelBg}"
                                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" CornerRadius="7"
                                                        Background="{DynamicResource Accent}"
                                                        BorderBrush="{DynamicResource WindowEdge}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条：默认那根白色柱子太扎眼 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#3A4252" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Margin="20,0,12,0" Background="Transparent" MouseLeftButtonDown="Root_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="设置" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="VersionText" FontSize="10" Margin="10,2,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}"/>
                </StackPanel>

                <Border Width="30" Height="26" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Cancel_Click">
                    <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiary}"/>
                </Border>
            </Grid>

            <!-- 内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：导航 -->
                <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Divider}" Margin="0,0,0,0">
                    <StackPanel x:Name="NavPanel" Margin="10,6,10,0">
                        <Border x:Name="Nav0" Tag="0" Height="34" CornerRadius="8" Cursor="Hand" Background="Transparent"
                                MouseLeftButtonDown="Nav_Click" MouseEnter="Nav_MouseEnter" MouseLeave="Nav_MouseLeave">
                            <Grid>
                                <Border x:Name="NavBar0" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="Transparent"/>
                                <TextBlock x:Name="NavText0" Text="常规" FontSize="12" Margin="16,0,8,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Nav1" Tag="1" Height="34" CornerRadius="8" Cursor="Hand" Background="Transparent"
                                Margin="0,2,0,0" MouseLeftButtonDown="Nav_Click" MouseEnter="Nav_MouseEnter" MouseLeave="Nav_MouseLeave">
                            <Grid>
                                <Border x:Name="NavBar1" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="Transparent"/>
                                <TextBlock x:Name="NavText1" Text="外观" FontSize="12" Margin="16,0,8,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Nav2" Tag="2" Height="34" CornerRadius="8" Cursor="Hand" Background="Transparent"
                                Margin="0,2,0,0" MouseLeftButtonDown="Nav_Click" MouseEnter="Nav_MouseEnter" MouseLeave="Nav_MouseLeave">
                            <Grid>
                                <Border x:Name="NavBar2" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="Transparent"/>
                                <TextBlock x:Name="NavText2" Text="导出与命名" FontSize="12" Margin="16,0,8,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Nav3" Tag="3" Height="34" CornerRadius="8" Cursor="Hand" Background="Transparent"
                                Margin="0,2,0,0" MouseLeftButtonDown="Nav_Click" MouseEnter="Nav_MouseEnter" MouseLeave="Nav_MouseLeave">
                            <Grid>
                                <Border x:Name="NavBar3" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="Transparent"/>
                                <TextBlock x:Name="NavText3" Text="数据与日志" FontSize="12" Margin="16,0,8,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border x:Name="Nav4" Tag="4" Height="34" CornerRadius="8" Cursor="Hand" Background="Transparent"
                                Margin="0,2,0,0" MouseLeftButtonDown="Nav_Click" MouseEnter="Nav_MouseEnter" MouseLeave="Nav_MouseLeave">
                            <Grid>
                                <Border x:Name="NavBar4" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                        Margin="2,0,0,0" Background="Transparent"/>
                                <TextBlock x:Name="NavText4" Text="关于" FontSize="12" Margin="16,0,8,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 右：分页 -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="20,4,16,0">
                    <Grid>

                        <!-- ① 常规 -->
                        <StackPanel x:Name="PageGeneral">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="主题" Style="{StaticResource CardTitle}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border x:Name="DarkBtn" Style="{StaticResource ThemeCard}" MouseLeftButtonDown="Dark_Click">
                                            <StackPanel>
                                                <Border Height="46" CornerRadius="7" Margin="9,9,9,0" Background="#141821">
                                                    <StackPanel Margin="8,7,0,0">
                                                        <Border Height="5" Width="52" CornerRadius="2" Background="#3A4252" HorizontalAlignment="Left"/>
                                                        <Border Height="5" Width="34" CornerRadius="2" Background="#38BDF8" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="深色" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border x:Name="LightBtn" Style="{StaticResource ThemeCard}" MouseLeftButtonDown="Light_Click">
                                            <StackPanel>
                                                <Border Height="46" CornerRadius="7" Margin="9,9,9,0" Background="#F4F1EA">
                                                    <StackPanel Margin="8,7,0,0">
                                                        <Border Height="5" Width="52" CornerRadius="2" Background="#D8D2C6" HorizontalAlignment="Left"/>
                                                        <Border Height="5" Width="34" CornerRadius="2" Background="#0EA5E9" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="浅色" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="切换后立刻生效，保存时会记住。" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="窗口" Style="{StaticResource CardTitle}"/>
                                    <CheckBox x:Name="TopmostBox" Content="窗口置顶（盖在别的软件上面，方便往 DAW 里拖）"
                                              Style="{StaticResource Check}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="新手引导" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="第一次用的那 6 步，可以再看一遍。" Style="{StaticResource Hint}"/>
                                    <Border Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            MouseLeftButtonDown="ReplayOnboarding_Click">
                                        <TextBlock Text="看一遍新手引导 ›" Style="{StaticResource BtnText}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ② 外观 -->
                        <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="主色" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="选一个预设，或者填一个 HEX。强调色、播放头、标签、选中态都会跟着变。"
                                               Style="{StaticResource Hint}"/>

                                    <WrapPanel x:Name="PresetRow" Orientation="Horizontal" Margin="0,12,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Border Width="96" Height="30" CornerRadius="8" Background="{DynamicResource SearchBg}"
                                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10,0">
                                            <TextBox x:Name="HexBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                                     Foreground="{DynamicResource TextPrimary}" VerticalContentAlignment="Center"
                                                     CaretBrush="{DynamicResource Accent}" TextChanged="HexBox_TextChanged"/>
                                        </Border>
                                        <Border x:Name="Swatch" Width="30" Height="30" CornerRadius="8" Margin="8,0,0,0"
                                                BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"/>
                                        <Border Style="{StaticResource Btn}" Margin="8,0,0,0" Height="30"
                                                MouseLeftButtonDown="ResetAccent_Click">
                                            <TextBlock Text="恢复默认" Style="{StaticResource BtnText}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="最近使用" FontSize="10.5" Margin="0,14,0,0"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <WrapPanel x:Name="RecentRow" Orientation="Horizontal" Margin="0,7,0,0"/>
                                    <TextBlock x:Name="RecentEmpty" Text="还没有换过主色" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextTertiary}"/>

                                    <TextBlock Text="收藏" FontSize="10.5" Margin="0,14,0,0"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <WrapPanel x:Name="FavoriteRow" Orientation="Horizontal" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Btn}" Height="26" Padding="10,0" Margin="0,0,0,0"
                                                MouseLeftButtonDown="FavoriteAccent_Click">
                                            <TextBlock Text="★ 收藏当前颜色" FontSize="10.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="点色块换回去；右键色块取消收藏。" FontSize="10" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextTertiary}"/>

                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="面板与圆角" Style="{StaticResource CardTitle}"/>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="面板强度" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <Slider x:Name="GlassSlider" Grid.Column="1" Style="{StaticResource ThinSlider}"
                                                Minimum="0" Maximum="1" SmallChange="0.02" LargeChange="0.1"
                                                VerticalAlignment="Center" ValueChanged="Glass_Changed"/>
                                        <TextBlock x:Name="GlassText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiary}"/>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="圆角" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <Slider x:Name="RadiusSlider" Grid.Column="1" Style="{StaticResource ThinSlider}"
                                                Minimum="0.5" Maximum="1.6" SmallChange="0.05" LargeChange="0.2"
                                                VerticalAlignment="Center" ValueChanged="Radius_Changed"/>
                                        <TextBlock x:Name="RadiusText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiary}"/>
                                    </Grid>

                                    <TextBlock Text="往左更透（能看见背景光），往右更实（字更清楚）。" Style="{StaticResource Hint}"/>

                                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,0"/>

                                    <CheckBox x:Name="MicaBox" Content="Windows 11 云母底板（窗口透出桌面模糊；Win10 上无效）"
                                              Style="{StaticResource Check}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ③ 导出与命名 -->
                        <StackPanel x:Name="PageExport" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="默认命名模板" Style="{StaticResource CardTitle}"/>
                                    <Border Height="34" CornerRadius="8" Background="{DynamicResource SearchBg}"
                                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="10,0"
                                            Margin="0,12,0,0">
                                        <TextBox x:Name="TemplateBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimary}" VerticalContentAlignment="Center"
                                                 CaretBrush="{DynamicResource Accent}"/>
                                    </Border>
                                    <TextBlock Text="可用字段：{n:00} 序号 · {name} 名称 · {index} 原编号 · {dur} 时长 · {sr} 采样率 · {ch} 声道 · {lib} 库名"
                                               Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="文件名清洗" Style="{StaticResource CardTitle}"/>
                                    <Border MinHeight="66" CornerRadius="8" Background="{DynamicResource SearchBg}"
                                            BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="8,6"
                                            Margin="0,12,0,0">
                                        <TextBox x:Name="RulesBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                                 Foreground="{DynamicResource TextPrimary}" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 CaretBrush="{DynamicResource Accent}" Height="48"/>
                                    </Border>
                                    <TextBlock Text="一行一条。文件名最后一个「-」之后如果含这些词，就把那一段去掉（拔刀相向-叮咚社版权素材 → 拔刀相向）"
                                               Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="文件关联" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="在资源管理器里右键音效文件，多一项「添加到音匣」。只写 HKCU，不需要管理员权限。"
                                               Style="{StaticResource Hint}"/>
                                    <Border x:Name="AssocBtn" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                            Margin="0,12,0,0" MouseLeftButtonDown="Assoc_Click">
                                        <TextBlock x:Name="AssocText" Text="注册右键「添加到音匣」" Style="{StaticResource BtnText}"/>
                                    </Border>
                                    <TextBlock Text="支持 .wav .mp3 .flac .aif .aiff .ogg .m4a" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ④ 数据与日志 -->
                        <StackPanel x:Name="PageData" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="数据位置" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="PathText" FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="OpenData_Click">
                                            <TextBlock Text="打开数据目录" Style="{StaticResource BtnText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="Rebuild_Click">
                                            <TextBlock Text="重建索引…" Style="{StaticResource BtnText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="Backup_Click">
                                            <TextBlock Text="备份数据…" Style="{StaticResource BtnText}"/>
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="PortableBtn" Style="{StaticResource Btn}" HorizontalAlignment="Left"
                                            Margin="0,8,0,0" MouseLeftButtonDown="Portable_Click">
                                        <TextBlock Text="切换为便携模式" Style="{StaticResource BtnText}"/>
                                    </Border>
                                    <TextBlock x:Name="PortableText" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextTertiary}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="日志与诊断" Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="出问题时点「导出诊断包」，把生成的 zip 发到 issue 就能定位（含日志、系统信息、设置；不含音频）。"
                                               Style="{StaticResource Hint}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="OpenLogs_Click">
                                            <TextBlock Text="打开日志目录" Style="{StaticResource BtnText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="ExportDiag_Click">
                                            <TextBlock Text="导出诊断包…" Style="{StaticResource BtnText}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ⑤ 关于 -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="音匣 SoundVault" Style="{StaticResource CardTitle}" FontSize="13"/>
                                    <TextBlock Text="本地音效库管理器。只给音效建索引，不移动、不复制、不修改你的文件。"
                                               Style="{StaticResource Hint}"/>
                                    <TextBlock Text="评分、标签、集合存在 store.json；波形与元信息存在 index.db，删了会自动重建。"
                                               Style="{StaticResource Hint}"/>
                                    <TextBlock Text="遇到问题先看日志，或用「数据与日志」里的导出诊断包。" Style="{StaticResource Hint}"/>
                                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,14,0,0"/>
                                    <TextBlock x:Name="AboutVersion" FontSize="10.5" Margin="0,12,0,0"
                                               Foreground="{DynamicResource TextSecondary}" Text=""/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="Feedback_Click">
                                            <TextBlock Text="反馈与建议…" Style="{StaticResource BtnText}"/>
                                        </Border>
                                        <Border Style="{StaticResource Btn}" MouseLeftButtonDown="OpenLogs2_Click">
                                            <TextBlock Text="打开日志目录" Style="{StaticResource BtnText}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- 底部按钮 -->
            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}">
                <Grid Margin="20,0,16,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Height="32" CornerRadius="8" Padding="18,0" Margin="0,0,10,0" Cursor="Hand"
                                Background="Transparent" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                                MouseLeftButtonDown="Cancel_Click">
                            <TextBlock Text="取消" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Height="32" CornerRadius="8" Padding="22,0" Cursor="Hand"
                                Background="{DynamicResource Accent}" MouseLeftButtonDown="Ok_Click">
                            <TextBlock Text="保存" Foreground="{DynamicResource OnAccent}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
