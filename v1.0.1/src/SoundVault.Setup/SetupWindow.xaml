<Window x:Class="SoundVault.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 音匣 SoundVault" Width="520" Height="400" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FF141821" FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        MouseLeftButtonDown="Window_MouseDown">

    <Window.Resources>
        <!-- 主按钮（强调色） -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#FF0B1220"/>
            <Setter Property="Background" Value="#FF38BDF8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#FFC8D0DE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF2A3040"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1B2130"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFF2F5FA"/>
        </Style>

        <Style x:Key="PageHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#FF8A93A6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF2A3040" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="164"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左侧品牌竖栏（参考 NSIS MUI2 的 modern-wizard.bmp）── -->
            <Grid Grid.Column="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF38BDF8" Offset="0"/>
                        <GradientStop Color="#FF6D28D9" Offset="0.62"/>
                        <GradientStop Color="#FF3B0F6B" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                    <Image Width="88" Height="88" Stretch="Uniform" Source="/Assets/logo-256.png"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center"/>
                    <TextBlock Text="音匣" FontSize="17" FontWeight="SemiBold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="SoundVault" FontSize="11" Foreground="#DDEDE9FF"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Margin="18,0,0,16">
                    <TextBlock x:Name="SideVersion" Text="v1.0.1" FontSize="10" Foreground="#CCFFFFFF"/>
                    <TextBlock Text="本地音效库管理器" FontSize="9.5" Foreground="#99FFFFFF" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ── 右侧：内容 + 按钮条 ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <Button x:Name="CloseBtn" Content="✕" Width="42" Height="30" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                        Foreground="#FF8A93A6" FontSize="11" Cursor="Hand" Click="Close_Click"/>

                <Grid Grid.Row="0" Margin="26,40,26,0">

                    <!-- ① 欢迎 -->
                    <StackPanel x:Name="PageWelcome" Visibility="Collapsed">
                        <TextBlock Text="欢迎使用 音匣 SoundVault" Style="{StaticResource PageTitle}"/>
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource PageHint}"
                                   Text="安装前先说明三件事，都是你会在意的："/>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Foreground="#FFC8D0DE" FontSize="11" TextWrapping="Wrap"
                                       Text="• 只建索引，不移动、不复制你的音效文件"/>
                            <TextBlock Foreground="#FFC8D0DE" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Text="• 单文件程序，不需要预装 .NET，不联网"/>
                            <TextBlock Foreground="#FFC8D0DE" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"
                                       Text="• 卸载默认保留评分、标签和集合；想清干净可以在卸载时勾选"/>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0" Style="{StaticResource PageHint}"
                                   Text="点「下一步」选择安装位置。"/>
                    </StackPanel>

                    <!-- ② 选择位置 -->
                    <StackPanel x:Name="PagePath" Visibility="Collapsed">
                        <TextBlock Text="选择安装位置" Style="{StaticResource PageTitle}"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#FF1B2130" BorderBrush="#FF2A3040" BorderThickness="1" CornerRadius="8" Height="34">
                                <TextBox x:Name="PathBox" Background="Transparent" BorderThickness="0" Foreground="#FFF2F5FA"
                                         VerticalContentAlignment="Center" Margin="10,0" CaretBrush="#FF38BDF8"
                                         LostFocus="PathBox_LostFocus"/>
                            </Border>
                            <Button Grid.Column="1" Content="浏览…" Width="72" Height="34" Margin="8,0,0,0"
                                    Style="{StaticResource GhostBtn}" Click="Browse_Click"/>
                        </Grid>

                        <CheckBox x:Name="StartMenuBox" Content="创建开始菜单快捷方式" IsChecked="True"
                                  Foreground="#FFC8D0DE" Margin="0,14,0,0"/>
                        <CheckBox x:Name="DesktopBox" Content="创建桌面快捷方式" IsChecked="True"
                                  Foreground="#FFC8D0DE" Margin="0,8,0,0"/>

                        <!-- 提示条：程序在运行 / 检测到旧版本 -->
                        <Border x:Name="NoticeBar" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="8"
                                Background="#1FFFCC66" BorderBrush="#66FFCC66" BorderThickness="1" Padding="10,8">
                            <TextBlock x:Name="NoticeText" FontSize="10.5" Foreground="#FFFFD98A" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- ③ 安装中 -->
                    <StackPanel x:Name="PageInstall" Visibility="Collapsed">
                        <TextBlock Text="正在安装" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="InstallTargetText" Margin="0,8,0,0" Style="{StaticResource PageHint}" Text=""/>

                        <Border x:Name="ProgressTrack" Height="6" CornerRadius="3" Background="#FF1B2130" Margin="0,20,0,0">
                            <Grid>
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                                        Background="#FF38BDF8"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="LogText" Foreground="#FFC8D0DE" FontSize="11" Margin="0,12,0,0"
                                   TextWrapping="Wrap" Height="46" Text="准备中…"/>

                        <TextBlock Text="安装过程中请不要关闭这个窗口。" Style="{StaticResource PageHint}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- ④ 完成 -->
                    <StackPanel x:Name="PageFinish" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="26" Height="26" CornerRadius="13" Background="#FF22C55E">
                                <TextBlock Text="✓" Foreground="White" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="安装完成" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="FinishPathText" Margin="0,14,0,0" Style="{StaticResource PageHint}" Text=""/>

                        <CheckBox x:Name="LaunchBox" Content="立即启动 音匣" IsChecked="True"
                                  Foreground="#FFC8D0DE" Margin="0,16,0,0"/>

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource PageHint}"
                                   Text="你的评分、标签、集合会保存在 %LocalAppData%\SoundVault，卸载时默认保留。"/>
                    </StackPanel>
                </Grid>

                <!-- 按钮条 -->
                <Border Grid.Row="1" Background="#FF1B2130" BorderBrush="#FF2A3040" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,18,0">
                        <Button x:Name="BackBtn" Content="上一步" Width="88" Margin="0,0,8,0"
                                Style="{StaticResource GhostBtn}" Click="Back_Click"/>
                        <Button x:Name="NextBtn" Content="下一步" Width="104" Margin="0,0,8,0"
                                Style="{StaticResource PrimaryBtn}" Click="Next_Click"/>
                        <Button x:Name="CancelBtn" Content="取消" Width="80"
                                Style="{StaticResource GhostBtn}" Click="Close_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
