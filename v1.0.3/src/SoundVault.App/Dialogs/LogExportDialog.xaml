<Window x:Class="SoundVault.App.Dialogs.LogExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出日志" Width="440" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <!-- 深色下的勾选框：白底方块会让文字看不见，这里自己画 -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F4F8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="4"
                                    BorderBrush="#66FFFFFF" BorderThickness="1" Background="#1AFFFFFF"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Foreground="#FF4DB8FF" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF4DB8FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF4DB8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FF16181D" Padding="20">
        <StackPanel>
            <TextBlock Text="导出范围" FontSize="12" FontWeight="SemiBold" Foreground="#FFF2F4F8"/>
            <ComboBox x:Name="RangeBox" Margin="0,8,0,0" Height="30" SelectionChanged="Range_Changed">
                <ComboBoxItem Content="最近 10 分钟" Tag="10"/>
                <ComboBoxItem Content="最近 20 分钟" Tag="20"/>
                <ComboBoxItem Content="最近 30 分钟" Tag="30"/>
                <ComboBoxItem Content="最近 1 小时" Tag="1h"/>
                <ComboBoxItem Content="最近 2 小时" Tag="2h"/>
                <ComboBoxItem Content="最近 1 天" Tag="1d"/>
                <ComboBoxItem Content="全部" Tag="all"/>
            </ComboBox>

            <CheckBox x:Name="WarnOnlyBox" Content="只导出警告和错误（WARN / ERROR）"
                      Style="{StaticResource DarkCheck}" Margin="0,14,0,0"
                      Checked="WarnOnly_Changed" Unchecked="WarnOnly_Changed"/>

            <TextBlock x:Name="EstimateText" Margin="0,14,0,0" FontSize="11"
                       Foreground="#FF9AA3B2" Text="正在估算…"/>

            <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#FF7C8698"
                       Text="导出内容：log.txt（按时间窗裁剪）、failures.csv（所有失败行）、system.txt、readme.txt。日志里含本机绝对路径。"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="导出…" Width="90" IsDefault="True" Click="Export_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
