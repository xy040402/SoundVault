<Window x:Class="SoundVault.App.Dialogs.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷搜索" Width="900" Height="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual">
    <Border CornerRadius="12" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1" MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：按住这里可以拖动窗口 -->
            <Grid Grid.Row="0" Margin="2,0,0,10" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QuickTitle" Text="快捷搜索" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="HotKeyTag" Grid.Column="1" Text="" FontSize="10" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="{DynamicResource TextTertiary}"/>
                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="6" Cursor="Hand"
                        Background="Transparent" MouseLeftButtonDown="Close_Click" ToolTip="关闭（Esc）">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Height="42" CornerRadius="9" Background="#1AFFFFFF"
                    BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox x:Name="Box" Margin="32,0,10,0" Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center" FontSize="15"
                             Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource Accent}"
                             TextChanged="Box_TextChanged" PreviewKeyDown="Box_PreviewKeyDown"/>
                </Grid>
            </Border>

            <ListBox x:Name="List" Grid.Row="2" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                     PreviewMouseLeftButtonDown="List_PreviewDown" PreviewMouseMove="List_PreviewMove"
                     PreviewMouseLeftButtonUp="List_PreviewUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" CornerRadius="7" Padding="10,9" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardActiveBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiary}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Ext}" FontSize="11" VerticalAlignment="Center"
                                       Margin="10,0,0,0" Foreground="{DynamicResource TextTertiary}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="Hint" Grid.Row="3" Margin="2,8,0,0" FontSize="11"
                       Foreground="{DynamicResource TextTertiary}"
                       Text="回车试听第一条 · ↑↓ 选择 · Esc 关闭"/>
        </Grid>
    </Border>
</Window>
