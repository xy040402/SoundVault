<Window x:Class="SoundVault.App.Dialogs.SupportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="支持作者" Width="420" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Background="#FF16181D" Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="微信赞赏码" FontSize="14" FontWeight="SemiBold" Foreground="#FFF2F4F8"/>

            <Border Margin="0,14,0,0" Padding="10" Background="White" CornerRadius="8"
                    HorizontalAlignment="Center">
                <Grid Width="250" Height="250">
                    <Image x:Name="Code" Stretch="Uniform" Visibility="Collapsed"/>
                    <TextBlock x:Name="Placeholder" Text="还没放赞赏码图片" FontSize="12" Foreground="#666666"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock x:Name="Hint" Margin="0,14,0,0" FontSize="11" TextWrapping="Wrap" Foreground="#FF9AA3B2"
                       Text="赞赏完全自愿，不影响任何功能，也没有付费版。"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Content="保存图片" Width="96" Margin="0,0,8,0" Click="Save_Click"/>
                <Button Content="关闭" Width="80" IsCancel="True" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
