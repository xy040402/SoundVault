<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.3</Version>
    <Product>音匣 SoundVault</Product>
    <AssemblyTitle>音匣 SoundVault</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 赞赏码：文件存在才打包，缺省不影响构建 -->
  <ItemGroup Condition="Exists('Assets\support-wechat.png')">
    <Resource Include="Assets\support-wechat.png" />
  </ItemGroup>
  <ItemGroup Condition="Exists('Assets\support-alipay.png')">
    <Resource Include="Assets\support-alipay.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="TinyPinyin.Net" Version="1.0.2" />
  </ItemGroup>

</Project>
